name "photo-wagon"
description "Local-first photo manager: Qt Quick UI in D with the indexer and a libp2p node in the same process"
license "MIT"
targetType "executable"
targetName "photo-wagon"
targetPath "."
sourcePaths "source"
importPaths "source"
stringImportPaths "data/places" "data/scenes" "data/clip"   // GeoNames cities (places.d), CLIP scene prompts (scenes.d), CLIP tokenizer vocab/merges (cliptext.d)

dependency "vibe-core" version="~>2.14"
dependency "vibe-stream:tls" version="~>1.4"   // TLS (vibe.stream.tls), for the Chromecast (CASTV2) control channel
dependency "libp2p" path="../libp2p-dlang"
dependency "hyperswarm" path="../d-hyperswarm"   // the UDX/hyperswarm sync transport (core/p2p/hswarm.d); its preBuild makes the host libhsudx.a

libs "sqlite3" "gexiv2" "vips" "gobject-2.0" "glib-2.0" "qrencode" "curl"   // curl: std.net.curl for DLNA SOAP

// QUIC (/quic-v1) as a libp2p transport: TLS 1.3 + native streams, and the DCUtR hole punch
// runs over it. ngtcp2 with its OpenSSL (>= 3.5) crypto backend; the version flag turns the
// transport on in libp2p-dlang.
versions "Libp2pQuic"
libs "ngtcp2" "ngtcp2_crypto_ossl" "ssl" "crypto"

// The C/C++ shims (csrc/build.sh): the OpenCV face + CLIP shims and sqlite-vec go into
// libface_opencv.a, linked by every config that does vision. The "node" config (a headless
// sync hub with no OpenCV) builds only sqlite-vec, into libface_novision.a — see below.

// The full application: UI + core. Needs the DSide binding generated at
// ../qt-dlang-gen (see README). Build with ldc2 or dmd; the matching binding
// archive is picked by compiler.
configuration "app" {
	targetType "executable"
	versions "WithUi"
	preBuildCommands "sh $PACKAGE_DIR/csrc/build.sh"
	sourceFiles "csrc/libface_opencv.a"
	libs "opencv_objdetect" "opencv_dnn" "opencv_imgcodecs" "opencv_imgproc" "opencv_flann" "opencv_core"
	libs "tesseract" "leptonica"   // the OCR shim (csrc/ocr_tesseract)
	importPaths "../qt-dlang-gen/generated/qt-6.11/cxx-quick" "../qt-dlang-gen/runtime/qrc"
	sourceFiles "../qt-dlang-gen/runtime/qrc/qrc.d"
	stringImportPaths "qml"
	sourceFiles "csrc/libclipboard_qt.a"   // the clipboard shim (csrc/clipboard_qt.h): QMimeData owned by Qt
	libs "Qt6Quick" "Qt6QmlModels" "Qt6Qml" "Qt6Gui" "Qt6Network" "Qt6Core" "stdc++"
	lflags "--start-group" "$PACKAGE_DIR/../qt-dlang-gen/.build/qt-6.11-cxx-quick/libbinding_ldc2.a" \
	       "$PACKAGE_DIR/../qt-dlang-gen/.build/qt-6.11-cxx-quick/libshims.a" "--end-group" \
	       "--gc-sections" "--as-needed" platform="ldc"
	lflags "--start-group" "$PACKAGE_DIR/../qt-dlang-gen/.build/qt-6.11-cxx-quick/libbinding_dmd.a" \
	       "$PACKAGE_DIR/../qt-dlang-gen/.build/qt-6.11-cxx-quick/libshims.a" "--end-group" \
	       "--gc-sections" "--as-needed" platform="dmd"
}

// Core only, no Qt: for a machine without the binding, or a server/TV box.
// The same binary as "app" also runs headless with --headless.
configuration "headless" {
	targetType "executable"
	targetName "photo-wagon-headless"
	preBuildCommands "sh $PACKAGE_DIR/csrc/build.sh"
	sourceFiles "csrc/libface_opencv.a"
	libs "opencv_objdetect" "opencv_dnn" "opencv_imgcodecs" "opencv_imgproc" "opencv_flann" "opencv_core" "stdc++"
	libs "tesseract" "leptonica"   // the OCR shim (csrc/ocr_tesseract)
	excludedSourceFiles "source/photowagon/ui/*"
}

// A headless sync hub with no OpenCV: for an always-on peer on a small server (a
// hole-punching node your machines sync with). Drops faces, CLIP scenes and the vision
// worker — those belong on the devices — so it builds without opencv5. sqlite-vec still
// comes in (libface_novision.a); the p2p node, indexer, kinds, places and store all stay.
configuration "node" {
	targetType "executable"
	targetName "photo-wagon-node"
	versions "PW_NoVision"
	preBuildCommands "PW_NO_OPENCV=1 sh $PACKAGE_DIR/csrc/build.sh"
	sourceFiles "csrc/libface_novision.a"
	excludedSourceFiles "source/photowagon/ui/*" \
		"source/photowagon/core/vision/worker.d" \
		"source/photowagon/core/library/clip.d" \
		"source/photowagon/core/library/scenes.d" \
		"source/photowagon/core/library/cliptext.d" \
		"source/photowagon/core/library/clipsearch.d" \
		"source/photowagon/core/library/ocr.d" \
		"source/photowagon/core/library/placemodel.d" \
		"source/photowagon/core/faces/service.d" \
		"source/photowagon/core/faces/detect.d" \
		"source/photowagon/core/faces/cluster.d" \
		"source/photowagon/core/api/face_api.d" \
		"source/photowagon/core/api/tags_api.d" \
		"source/photowagon/core/api/search_api.d"
}

// A desk-side stand-in for the phone (tools/hsprobe.d): joins the sync topic for a pairing
// token as a hyperswarm client and sends daemon.auth, so DHT lookup → connect → HsServe →
// auth is provable without a device. Same no-OpenCV footprint as "node".
configuration "hsprobe" {
	targetType "executable"
	targetName "hsprobe"
	versions "PW_NoVision"
	preBuildCommands "PW_NO_OPENCV=1 sh $PACKAGE_DIR/csrc/build.sh"
	sourceFiles "csrc/libface_novision.a"
	mainSourceFile "tools/hsprobe.d"
	excludedSourceFiles "source/photowagon/main.d" \
		"source/photowagon/ui/*" \
		"source/photowagon/core/vision/worker.d" \
		"source/photowagon/core/library/clip.d" \
		"source/photowagon/core/library/scenes.d" \
		"source/photowagon/core/library/cliptext.d" \
		"source/photowagon/core/library/clipsearch.d" \
		"source/photowagon/core/library/ocr.d" \
		"source/photowagon/core/library/placemodel.d" \
		"source/photowagon/core/faces/service.d" \
		"source/photowagon/core/faces/detect.d" \
		"source/photowagon/core/faces/cluster.d" \
		"source/photowagon/core/api/face_api.d" \
		"source/photowagon/core/api/tags_api.d" \
		"source/photowagon/core/api/search_api.d"
}

configuration "unittest" {
	targetType "executable"
	targetName "photo-wagon-test"
	preBuildCommands "sh $PACKAGE_DIR/csrc/build.sh"
	sourceFiles "csrc/libface_opencv.a"
	libs "opencv_objdetect" "opencv_dnn" "opencv_imgcodecs" "opencv_imgproc" "opencv_flann" "opencv_core" "stdc++"
	libs "tesseract" "leptonica"   // the OCR shim (csrc/ocr_tesseract)
	excludedSourceFiles "source/photowagon/ui/*" "source/photowagon/main.d"
	mainSourceFile "tests/runner.d"
	sourcePaths "source" "tests"
	importPaths "source" "tests"
}
