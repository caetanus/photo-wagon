name "photowagond"
description "Photo Wagon daemon — indexer, content store, library queries, libp2p node"
license "MIT"
targetType "executable"
targetName "photowagond"
targetPath "."
sourcePaths "source"
importPaths "source"

dependency "vibe-core" version="~>2.14"
dependency "libp2p" path="../../libp2p-dlang"

libs "sqlite3" "gexiv2" "vips" "gobject-2.0" "glib-2.0"

configuration "application" {
	targetType "executable"
}

configuration "unittest" {
	targetType "executable"
	targetName "photowagond-test"
	excludedSourceFiles "source/photowagond/app.d"
	mainSourceFile "tests/runner.d"
	sourcePaths "source" "tests"
	importPaths "source" "tests"
}
