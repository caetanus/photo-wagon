# Pinned inputs of the release build (sourced by packaging/*.sh and the workflows).
# The sibling repositories are cloned next to photo-wagon at these exact commits — the ones the
# app is developed against (their default branches move on their own; qml-css-engine's did, to
# an API this app does not use yet). Bump them together with the code that needs the change.
DSIDE_REPO=https://github.com/caetanus/dside.git
DSIDE_REF=f7cf13b6a9ebcf7b0a0c72d2ebe58482e8e526fe
HYPERSWARM_REPO=https://github.com/caetanus/d-hyperswarm.git
HYPERSWARM_REF=d209260c360c22bb9a10da018c0fc93a6d8bd605
LIBP2P_REPO=https://github.com/caetanus/libp2p-dlang.git
LIBP2P_REF=9d04e2eab4577f71461edd47945587a6570cf707
WEBRTC_REPO=https://github.com/caetanus/d-webrtc.git
WEBRTC_REF=cdcfee252040826103716cdb482c00f46271a8fc
QMLCSS_REPO=https://github.com/caetanus/qml-css-engine.git
QMLCSS_REF=28184263dbeed8713f2d1baf439d40d82f17cb68

# Toolchain and the libraries no target distribution ships in the version we need.
LDC_VERSION=1.43.0
OPENCV_VERSION=5.0.0
NGTCP2_VERSION=1.25.0
OPENSSL_VERSION=3.5.9
