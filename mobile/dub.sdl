name "photo-wagon-mobile"
description "Photo Wagon for a phone: the same Qt Quick UI in D, talking to a photo-wagon --serve on the network"
license "MIT"
targetPath "."
sourcePaths "source"
importPaths "source" "../source" "../../qt-dlang-gen/generated/qt-6.11/cxx-quick" "../../qt-dlang-gen/runtime/qrc"
sourceFiles "../source/photowagon/ui/backend.d" "../source/photowagon/ui/gridrows.d" "../source/photowagon/ui/transport.d" \
	"../source/photowagon/ui/bridge.d" "../source/photowagon/core/ipc/link.d" \
	"../source/photowagon/core/p2p/identity.d" \
	"../source/photowagon/core/indexer/scan.d" "../source/photowagon/core/library/calendar.d" "../source/photowagon/core/jobs/memguard.d" \
	"../source/photowagon/core/library/kind.d" "../source/photowagon/core/thumbs/imagestats.d" \
	"../source/photowagon/core/metadata/exifparse.d" "../source/photowagon/core/metadata/datefromname.d" \
	"../source/photowagon/core/pairingcode.d" "../source/photowagon/core/sync/pieces.d" "../source/photowagon/core/sync/digest.d" \
	"../../qt-dlang-gen/runtime/qrc/qrc.d"
stringImportPaths "../qml"
// libp2p on the phone: the lite build (Ed25519 only, IP addresses only — no OpenSSL, no c-ares)
dependency "vibe-core" version="~>2.14"
dependency "libp2p" path="../../libp2p-dlang"
versions "LibP2P_Lite"
// webrtc-direct beside TCP (libp2p-dlang builds its webrtc transport in the default config)
versions "Libp2pWebrtc"

// Same client, host build: for developing the phone UI offscreen against a
// `photo-wagon --headless --ipc-address 0.0.0.0` on this machine.
configuration "desktop" {
	targetType "executable"
	targetName "photo-wagon-mobile"
	// hsession.d is the parked hyperswarm/udx session (needs ../d-hyperswarm); not built here
	excludedSourceFiles "source/photowagon/mobile/hsession.d"
	libs "Qt6Quick" "Qt6QmlModels" "Qt6Qml" "Qt6Gui" "Qt6Network" "Qt6Core" "stdc++"
	lflags "--start-group" "$PACKAGE_DIR/../../qt-dlang-gen/.build/qt-6.11-cxx-quick/libbinding_ldc2.a" \
	       "$PACKAGE_DIR/../../qt-dlang-gen/.build/qt-6.11-cxx-quick/libshims.a" "--end-group" \
	       "--gc-sections" "--as-needed" platform="ldc"
	lflags "--start-group" "$PACKAGE_DIR/../../qt-dlang-gen/.build/qt-6.11-cxx-quick/libbinding_dmd.a" \
	       "$PACKAGE_DIR/../../qt-dlang-gen/.build/qt-6.11-cxx-quick/libshims.a" "--end-group" \
	       "--gc-sections" "--as-needed" platform="dmd"
}

// Host compile-check of the udx/hyperdht/hyperswarm phone flavor (version PwHyperswarm):
// links d-hyperswarm (host libudx via its preBuild) and builds hswarm.d/muxstream.d/pieces.d.
// Not for shipping — the real target is build-android.sh with the Android udx archives.
configuration "desktop-hs" {
	targetType "executable"
	targetName "photo-wagon-mobile-hs"
	versions "PwHyperswarm"
	dependency "hyperswarm" path="../../d-hyperswarm"
	// hsession.d: the parked HsSession (never constructed; the live path is P2pBridge.hsRun
	// over muxstream). Excluded like the desktop config and build-android.sh do.
	excludedSourceFiles "source/photowagon/mobile/hsession.d"
	sourceFiles "../source/photowagon/core/p2p/hswarm.d" "../source/photowagon/core/sync/muxstream.d"
	libs "Qt6Quick" "Qt6QmlModels" "Qt6Qml" "Qt6Gui" "Qt6Network" "Qt6Core" "stdc++"
	lflags "--start-group" "$PACKAGE_DIR/../../qt-dlang-gen/.build/qt-6.11-cxx-quick/libbinding_ldc2.a" \
	       "$PACKAGE_DIR/../../qt-dlang-gen/.build/qt-6.11-cxx-quick/libshims.a" "--end-group" \
	       "--gc-sections" "--as-needed" platform="ldc"
	lflags "--start-group" "$PACKAGE_DIR/../../qt-dlang-gen/.build/qt-6.11-cxx-quick/libbinding_dmd.a" \
	       "$PACKAGE_DIR/../../qt-dlang-gen/.build/qt-6.11-cxx-quick/libshims.a" "--end-group" \
	       "--gc-sections" "--as-needed" platform="dmd"
}

// Android arm64: a shared library Qt's activity loads and calls main() in.
// Driven by build-android.sh, which supplies the cross flags (-mtriple, the
// ldc2.conf with the Android runtime, the cross binding archives, Qt for
// Android). See ../ANDROID.md.
configuration "android" {
	targetType "dynamicLibrary"
	targetName "photo-wagon-mobile_arm64-v8a"
	versions "PhotoWagonMobile"
}
