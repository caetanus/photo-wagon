# Maintainer: Marcelo A Caetano <rockristao@gmail.com>
# Generated by packaging/arch/make-pkgbuild.sh — edit the template, not the AUR copy.
pkgname=photo-wagon
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Local-first photo library with faces, places and peer-to-peer sync"
arch=(x86_64)
url="https://github.com/caetanus/photo-wagon"
license=(MIT)
depends=(qt6-base qt6-declarative qt6-multimedia qt6-location qt6-positioning qt6-imageformats
         qt6-wayland sqlite libgexiv2 libvips glib2 qrencode curl libsodium c-ares openssl
         tesseract leptonica)
makedepends=(git ldc dub cmake ninja meson clang llvm patchelf python)
optdepends=('tesseract-data-por: read text in Portuguese screenshots and documents')
options=(!debug !lto)
source=("photo-wagon::git+https://github.com/caetanus/photo-wagon.git#commit=@PW_COMMIT@"
        "qt-dlang-gen::git+https://github.com/caetanus/dside.git#commit=@DSIDE_COMMIT@"
        "d-hyperswarm::git+https://github.com/caetanus/d-hyperswarm.git#commit=@HYPERSWARM_COMMIT@"
        "libp2p-dlang::git+https://github.com/caetanus/libp2p-dlang.git#commit=@LIBP2P_COMMIT@"
        "d-webrtc-v3::git+https://github.com/caetanus/d-webrtc.git#commit=@WEBRTC_COMMIT@"
        "qml-css-engine::git+https://github.com/caetanus/qml-css-engine.git#commit=@QMLCSS_COMMIT@")
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP)

build() {
    # The DSide binding is generated here from the installed Qt's own headers, and OpenCV 5
    # (Arch ships it, but the package keeps the one it was tested with) is built privately.
    cd "$srcdir/photo-wagon"
    SKIP_DEPS=1 USE_SYSTEM_LDC=1 DEPS="$srcdir/deps" sh packaging/linux/build.sh "$srcdir/stage"
}

package() {
    cp -a "$srcdir/stage/." "$pkgdir/"
}
